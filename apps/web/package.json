{
  "name": "@neurovision/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && vite build --config vite.standalone.config.ts",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "preview": "vite preview",
    "test": "tsx --test test/service.test.ts test/standalone.test.ts test/web.test.ts test/api-client.test.ts test/oidc.test.ts test/browser-session-bridge.test.ts",
    "test:e2e": "tsx --test test/e2e.test.ts"
  },
  "dependencies": {
    "@neurovision/domain": "*",
    "@neurovision/gaze": "*",
    "jspdf": "^4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.4",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
