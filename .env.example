# Copy to .env and replace every placeholder. Do not commit .env.
# Never commit secrets. Production values live in the Vercel project env, not in git.
NODE_ENV=development
IDENTITY_MODE=local
DEMO_SEED=true
COOKIE_SECURE=false
PORT=3001
HOST=0.0.0.0

# Hosted Postgres (Tiger Cloud / Timescale). TLS query flags are required.
# `npm run dev` uses this string only. S3/MinIO and OIDC are not required.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tsdb?uselibpqcompat=true&sslmode=require

# Web talks to the API on the same origin (Vite proxy locally, Vercel Function in production).
VITE_API_BASE_URL=/
VITE_IDENTITY_MODE=local

# Optional. Serverless (Vercel) uses 1. Local API uses the driver default when unset.
# PG_POOL_MAX=1

# Optional: docker compose (`npm run dev:backend`).
POSTGRES_USER=neurovision
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=neurovision
WORKER_ID=worker-local

# Optional. When unset, traces persist in Postgres instead of S3/MinIO.
# OBJECT_STORE=s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=neurovision-traces
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me

# Required only when IDENTITY_MODE=oidc.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback
