# Copy to .env and replace every placeholder. Do not commit .env.
NODE_ENV=development
IDENTITY_MODE=local
DEMO_SEED=true
COOKIE_SECURE=false
PORT=3001
HOST=0.0.0.0

POSTGRES_USER=neurovision
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=neurovision
DATABASE_URL=postgres://neurovision:replace-me@postgres:5432/neurovision

OBJECT_STORE=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=neurovision-traces
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Required only when IDENTITY_MODE=oidc. Leave unset for local identity.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback

WORKER_ID=worker-local
